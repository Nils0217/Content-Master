          "y": 360
        },
        "measured": {
          "width": 150,
          "height": 40
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "db_hydradb_1",
      "provider": "db_hydradb",
      "config": {
        "profile": "default",
        "default": {
          "api_key": "${ROCKETRIDE_HYDRADB_API_KEY}",
          "database": "${ROCKETRIDE_HYDRADB_DATABASE}",
          "collection": "automarketer",
          "max_results": 10
        }
      },
      "control": [
        {
          "classType": "tool",
          "from": "agent_rocketride_1"
        }
      ],
      "ui": {
        "position": {
          "x": 640,
