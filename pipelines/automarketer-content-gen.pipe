    {
      "id": "tool_cognee_1",
      "provider": "tool_cognee",
      "config": {
        "type": "tool_cognee",
        "base_url": "${ROCKETRIDE_COGNEE_URL}",
        "api_key": "${ROCKETRIDE_COGNEE_API_KEY}",
        "dataset": "automarketer",
        "allow_dataset_override": false,
        "search_type": "GRAPH_COMPLETION_DECOMPOSITION",
        "top_k": 15,
        "request_timeout": 120
      },
      "control": [
        {
          "classType": "tool",
          "from": "agent_rocketride_1"
        }
      ],
      "ui": {
        "position": {
