# Copy to .env and fill in real values. See README.md for full context.

ROCKETRIDE_URI=https://staging.rocketride.ai
ROCKETRIDE_API_KEY=your-rocketride-api-key
ROCKETRIDE_APIKEY=your-rocketride-api-key

ROCKETRIDE_COGNEE_URL=http://localhost:8000
ROCKETRIDE_COGNEE_API_KEY=your-cognee-api-key

# db_hydradb needs a managed HydraDB Cloud database, not the local
# self-hosted graph-node this project otherwise uses directly.
ROCKETRIDE_HYDRADB_API_KEY=your-hydradb-cloud-api-key
ROCKETRIDE_HYDRADB_DATABASE=your-hydradb-cloud-database-name

COGNEE_BASE_URL=http://localhost:8000
COGNEE_EMAIL=you@example.com
COGNEE_PASSWORD=change-me
COGNEE_DATASET=automarketer

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_ENDPOINT=http://host.docker.internal:11434
LLM_API_KEY=ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_ENDPOINT=http://host.docker.internal:11434/api/embed
EMBEDDING_DIMENSIONS=768
HUGGINGFACE_TOKENIZER=nomic-ai/nomic-embed-text-v1.5

HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_AUTH_TOKEN_FILE=hydradb-data/auth-token
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH=default
HYDRADB_CELL_ID=cell-0

HOTDATA_ENABLED=true
HOTDATA_API_KEY=
HOTDATA_WORKSPACE_ID=your-hotdata-workspace-id
