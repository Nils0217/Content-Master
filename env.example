# Copy to .env and fill in real values. See README.md for full context.

COGNEE_BASE_URL=http://localhost:8000
COGNEE_EMAIL=you@example.com
COGNEE_PASSWORD=change-me
COGNEE_DATASET=contentmaster

# --- For the COGNEE CONTAINER, not for this Python package -------------
# 2026-09-19: labelled explicitly because it was not obvious. Nothing in
# src/contentmaster/ reads any of these; scripts/configure_cognee_llm.sh
# passes them into the Docker container so Cognee has an LLM of its own.
# Note the asymmetry (see docs/ERROR_LOG.md): from inside the container the
# host is `host.docker.internal`, NOT localhost, and LLM_ENDPOINT must not
# carry a /v1 suffix while EMBEDDING_ENDPOINT does keep its own path.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_ENDPOINT=http://host.docker.internal:11434
LLM_API_KEY=ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_ENDPOINT=http://host.docker.internal:11434/api/embed
EMBEDDING_DIMENSIONS=768
HUGGINGFACE_TOKENIZER=nomic-ai/nomic-embed-text-v1.5

# --- For THIS package: draft generation + the discuss step -------------
# 2026-09-19 (code scan): these six were read by the code but missing from
# this file entirely, so the only way to discover them was to grep the
# source. Note the endpoint here IS the /v1 OpenAI-compatible one and DOES
# use localhost — this package runs on the host, unlike Cognee above.
# All optional; the defaults below are what the code already assumes.

# draft_generator.py — writes and revises the actual posts
LLM_IMPROVE_ENDPOINT=http://localhost:11434/v1/chat/completions
LLM_IMPROVE_MODEL=llama3.2:3b

# discuss.py — two DIFFERENT local models each propose a next-post
# strategy independently. Same-model self-debate mostly agrees with
# itself, so these should stay different from each other.
DISCUSS_MODEL_A=llama3.2:3b
DISCUSS_MODEL_B=mistral:latest

# Optional third "judge" pass that merges the two proposals above. OFF by
# default on purpose: with no DISCUSS_JUDGE_MODEL set it falls back to
# DISCUSS_MODEL_A, i.e. Advisor A judging its own proposal, which is not
# independent judgment. Set a genuinely different third model here before
# turning DISCUSS_JUDGE_ENABLED on.
# DISCUSS_JUDGE_MODEL=
DISCUSS_JUDGE_ENABLED=0

# Bluesky (AT Protocol) — see scripts/verify_bluesky.py
# Use an App Password (bsky.app -> Settings -> App Passwords), never your
# main account password. Never commit real values here.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Cloudflare Workers AI — image generation (FLUX.1-schnell), Phase 4.
# Free tier: 10,000 Neurons/day (~173 images), no expiry. Get an Account
# ID (dashboard, or `wrangler whoami`) and an API token with Workers AI
# access (dashboard -> My Profile -> API Tokens). Optional — image
# generation is silently skipped (text-only post) if unset.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
